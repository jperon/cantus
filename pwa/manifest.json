{
  "name": "Cantus",
  "short_name": "Cantus",
  "description": "Offline MusicXML sheet music reader",
  "id": "cantus",
  "start_url": "./",
  "display": "standalone",
  "background_color": "#ffffff",
  "theme_color": "#2196f3",
  "orientation": "portrait",
  "scope": "./",
  "lang": "en",
  "categories": ["music", "education", "productivity"],
  "protocol_handlers": [
    {
      "protocol": "web+musicxml",
      "url": "./?file=%s"
    },
    {
      "protocol": "web+mxml",
      "url": "./?file=%s"
    }
  ],
  "file_handlers": [
    {
      "action": "./",
      "accept": {}
    }
  ],
  "share_target": {
    "action": "./share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "files": [
        {
          "name": "file",
          "accept": []
        }
      ]
    }
  },
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "screenshots": [
    {
      "src": "screenshots/mobile-1.png",
      "sizes": "390x844",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "De âlde Friezen (CC0) open in the reader"
    },
    {
      "src": "screenshots/mobile-2.png",
      "sizes": "390x844",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Settings panel open over the score"
    },
    {
      "src": "screenshots/desktop-1.png",
      "sizes": "1280x720",
      "type": "image/png",
      "form_factor": "wide",
      "label": "Desktop view during playback with the current measure highlighted"
    }
  ]
}
