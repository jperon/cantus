doctype html
html(lang="en")
  head
    meta(charset="utf-8")
    meta(name="viewport" content="width=device-width, initial-scale=1, maximum-scale=5")
    meta(name="description" content="Cantus is an offline MusicXML reader. Open and view your sheet music in MusicXML and MXL format with an intuitive interface and high-quality rendering." data-i18n-content="app.description")
    meta(name="mobile-web-app-capable" content="yes")
    meta(name="apple-mobile-web-app-capable" content="yes")
    meta(name="apple-mobile-web-app-status-bar-style" content="default")
    meta(name="apple-mobile-web-app-title" content="Cantus")
    meta(name="theme-color" content="#ffffff")
    meta(name="keywords" content="MusicXML, sheet music, music, reader, offline, PWA, cantus, score")
    meta(name="author" content="Cantus")
    link(rel="manifest" href="manifest.json")
    link(rel="icon" href="favicon.ico" type="image/x-icon")
    link(rel="apple-touch-icon" href="icons/icon-192.png")
    title MusicXML Reader
    style !{css}
  body
    #reader
      #score-container
        #page-prev.svg-slot
        #page-current.svg-slot
        #page-next.svg-slot
      #tap-left
      #tap-right
      #import-section
        h1(data-i18n="import.title") MusicXML Reader
        p(data-i18n="import.subtitle") Open a MusicXML file to get started
        button#import-btn(data-i18n="import.openFile") Open a file
        input#file-input(type="file" multiple accept=importAccept)
        button#folder-btn(data-i18n="import.openFolder") Open a folder
        input#folder-input(type="file" webkitdirectory accept=importAccept)
        #install-section.hidden
          button#btn-install(data-i18n="import.install") Install Cantus
          p.install-subtitle(data-i18n="import.installSubtitle") Turn Cantus into a native app
    #overlay-loading
      .spinner
      p(data-i18n="loading") Loading…
    #overlay-error
      p#error-message(data-i18n="error.generic") Something went wrong.
    #settings-overlay.hidden
      #settings-header
        h2(data-i18n="settings.title") Settings
        button#settings-close(data-i18n-aria-label="settings.close" aria-label="Close settings") ✕
      .settings-group
        label.settings-label(data-i18n="settings.zoom") Zoom
        .settings-row
          span#zoom-value 40
          input#zoom-range(type="range" min="30" max="80" step="5" value="40")
      .settings-group
        label.settings-label(for="language-select" data-i18n="settings.language") Language
        .settings-row
          select#language-select
      .settings-pair
        .settings-group
          label.settings-label(for="master-volume-range" data-i18n="settings.masterVolume") Master volume
          .settings-row
            span#master-volume-value 80
            input#master-volume-range(type="range" min="0" max="100" step="5" value="80" aria-label="Master volume" data-i18n-aria-label="settings.masterVolume")
        .settings-group
          label.settings-label(for="tempo-input" data-i18n="settings.tempo") Playback tempo
          .settings-row
            input#tempo-input.settings-number(type="number" min="20" max="300" step="1" value="80" inputmode="numeric" aria-label="Playback tempo per minute")
            span#tempo-unit.tempo-unit(title="quarter note") ♩
            span /min
            button#tempo-reset.settings-btn.tempo-reset(type="button" title="Reset to the file tempo" data-i18n-title="settings.tempoResetTitle" data-i18n="settings.tempoReset" disabled) File tempo
          p#tempo-hint.settings-hint(data-i18n="tempo.pending") Determining the file tempo…
      .settings-group
        label.settings-label(data-i18n="settings.transposition") Transposition
        .settings-row.settings-transpose
          label.transpose-field
            span.transpose-label(data-i18n="settings.transposeVisual") Score
            select#transpose-visual.transpose-select(data-i18n-aria-label="settings.transposeVisualAria")
          label.transpose-field
            span.transpose-label(data-i18n="settings.transposeAudio") Sound
            select#transpose-audio.transpose-select(data-i18n-aria-label="settings.transposeAudioAria")
      #parts-group.settings-group.hidden
        label.settings-label(data-i18n="settings.parts") Parts
        #parts-list
        .settings-row
          button#parts-sizes-reset.settings-btn(type="button" data-i18n="settings.partsSizesReset" disabled) Sizes to 100%
          button#parts-volumes-reset.settings-btn(type="button" data-i18n="settings.partsVolumesReset" disabled) Volumes to 100%
      .settings-group
        label.settings-label(data-i18n="settings.playback") Playback
        .settings-row
          label.settings-check
            input#follow-playback(type="checkbox" checked)
            span(data-i18n="settings.followPlayback") Follow scrolling
          label.settings-check
            input#expand-repeats(type="checkbox" checked)
            span(data-i18n="settings.expandRepeats") Expand repeats
          label.settings-check
            input#piano-only(type="checkbox")
            span(data-i18n="settings.pianoOnly") Piano only
          p.settings-hint(data-i18n="settings.expandRepeatsHint") Unchecked: linear playback in written order (no repeats, D.C./D.S., coda or endings).
      .settings-group
        label.settings-label(data-i18n="settings.theme") Theme
        .settings-row
          button.theme-btn.active(data-theme="white" data-i18n="theme.white") White
          button.theme-btn(data-theme="sepia" data-i18n="theme.sepia") Sepia
          button.theme-btn(data-theme="dark" data-i18n="theme.dark") Dark
      .settings-group
        label.settings-label(data-i18n="settings.tapZone") Tap zone
        .settings-row
          button.tap-btn(data-size="20" data-i18n="tap.small") Small
          button.tap-btn.active(data-size="30" data-i18n="tap.normal") Normal
          button.tap-btn(data-size="40" data-i18n="tap.large") Large
      .settings-group
        label.settings-label(data-i18n="settings.layout") Layout
        .settings-row(role="group" aria-label="Layout" data-i18n-aria-label="settings.layout")
          button.layout-btn.active(data-layout="auto" data-i18n="layout.auto") Auto
          button.layout-btn(data-layout="horizontal" data-i18n="layout.horizontal") Horizontal
          button.layout-btn(data-layout="vertical" data-i18n="layout.vertical") Vertical
      .settings-group
        label.settings-label(data-i18n="settings.scroll") Scrolling
        .settings-row
          button.scroll-unit-btn.active(data-unit="page" data-i18n="scroll.page") Per page
          button.scroll-unit-btn(data-unit="system" data-i18n="scroll.system") Per system
        .settings-row#overlap-row
          span(data-i18n="settings.overlap") Overlap
          select#overlap-select
            option(value="0") 0 %
            option(value="10") 10 %
            option(value="20") 20 %
            option(value="30") 30 %
            option(value="40") 40 %
            option(value="50") 50 %
      .settings-group
        label.settings-label(data-i18n="settings.storage") Storage
        .settings-row
          span#storage-info 0MB / 16MB
          button#btn-storage(data-i18n="settings.clearCache") Clear cache
      .settings-group
        label.settings-label(data-i18n="settings.about") About
        .settings-row
          span(data-i18n="settings.version") Cantus v1.0 - MusicXML Reader
        .settings-row
          span#build-date
        .settings-row
          small(data-i18n="settings.license") Free software under the GNU GPL v3 or later, with no warranty.
        .settings-row
          small
            a(href="https://github.com/jperon/cantus" target="_blank" rel="noopener" data-i18n="settings.sourceCode") Source code
          small
            a(href="https://github.com/jperon/cantus/blob/master/THIRD-PARTY.md" target="_blank" rel="noopener" data-i18n="settings.thirdParty") Third-party components
        .settings-row
          small
            span(data-i18n="settings.soundfontCredit") TimGM6mb General MIDI soundfont, SpessaSynth synthesis —
            = ' '
            a(href="https://www.gnu.org/licenses/old-licenses/gpl-2.0.html" target="_blank" rel="noopener") GPL-2.0
            = ' · '
            a(href="https://www.apache.org/licenses/LICENSE-2.0" target="_blank" rel="noopener") Apache-2.0
    #library-overlay.hidden
      #library-header
        h2(data-i18n="library.title") Library
        button#library-close(data-i18n-aria-label="library.close" aria-label="Close library") ✕
      #library-list
      #library-actions
        button#library-import-btn(data-i18n="library.addFile") Add a file
        input#library-file-input(type="file" multiple accept=importAccept)
        button#library-folder-btn(data-i18n="library.addFolder") Add a folder
        input#library-folder-input(type="file" webkitdirectory accept=importAccept)
    #page-indicator
    #loading-indicator.hidden
      .spinner-small
    #command-bar
      #transport.transport-group.hidden(role="group" aria-label="Audio playback" data-i18n-aria-label="transport.group")
        button#transport-play.transport-btn(type="button" title="Play / pause (p)" data-i18n-title="transport.playPauseTitle" aria-label="Play" data-i18n-aria-label="transport.playAria") ▶
        button#transport-stop.transport-btn(type="button" title="Stop (s)" data-i18n-title="transport.stopTitle" aria-label="Stop" data-i18n-aria-label="transport.stop") ■
        span#transport-time(title="Click to seek in the playback" data-i18n-title="transport.timeTitle") 0:00 / 0:00
      #nav-buttons.nav-group
        button.nav-btn(data-action="start" title="Start" data-i18n-title="nav.start") ⏮
        button.nav-btn(data-action="prev-mov" title="Previous movement" data-i18n-title="nav.prevMovement") ◀◀
        button.nav-btn(data-action="prev-5" title="5 pages back" data-i18n-title="nav.prev5") −5
        span#page-number
        button.nav-btn(data-action="next-5" title="5 pages forward" data-i18n-title="nav.next5") +5
        button.nav-btn(data-action="next-mov" title="Next movement" data-i18n-title="nav.nextMovement") ▶▶
        button.nav-btn(data-action="end" title="End" data-i18n-title="nav.end") ⏭
      #command-actions.icons-group
        button#btn-library.hidden(type="button" title="Library" data-i18n-title="nav.library" aria-label="Library" data-i18n-aria-label="nav.library") ☰
        button#btn-settings.hidden(type="button" title="Settings" data-i18n-title="nav.settings" aria-label="Settings" data-i18n-aria-label="nav.settings") ⚙
    script.
      window.__musicaBuildDate = "#{buildDate}"
      window.__musicaScoretkAvailable = #{scoretkAvailable ? 'true' : 'false'}
      window.__musicaSoundfontAvailable = #{soundfontsAvailable ? 'true' : 'false'}
    script !{workerSetup}
    script !{fflateSetup}
    script !{mxlJs}
    script !{storageJs}
    script !{svgCacheJs}
    script !{playbackCacheJs}
    script !{midiJs}
    script !{formatsJs}
    script !{timelineJs}
    script !{i18nJs}
    //- Bundle SpessaSynth (window.__musicaSpessa) : la banque et le processeur
    //- AudioWorklet de soundfonts/ sont chargés paresseusement au premier play().
    script !{spessaJs}
    script !{audioJs}
    script !{playbackJs}
    script !{appJs}
