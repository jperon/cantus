doctype html
html(lang="en")
  head
    meta(charset="utf-8")
    meta(name="viewport" content="width=device-width, initial-scale=1, maximum-scale=5")
    meta(name="description" content="Cantus is an offline MusicXML reader. Open and view your sheet music in MusicXML and MXL format with an intuitive interface and high-quality rendering." data-i18n-content="app.description")
    meta(name="mobile-web-app-capable" content="yes")
    meta(name="apple-mobile-web-app-capable" content="yes")
    meta(name="apple-mobile-web-app-status-bar-style" content="default")
    meta(name="apple-mobile-web-app-title" content="Cantus")
    meta(name="theme-color" content="#ffffff")
    meta(name="keywords" content="MusicXML, sheet music, music, reader, offline, PWA, cantus, score")
    meta(name="author" content="Cantus")
    link(rel="manifest" href="manifest.json")
    link(rel="icon" href="favicon.ico" type="image/x-icon")
    link(rel="apple-touch-icon" href="icons/icon-192.png")
    title MusicXML Reader
    style !{css}
  body
    #reader
      #score-container
        #page-prev.svg-slot
        #page-current.svg-slot
        #page-next.svg-slot
      #tap-left
      #tap-right
      #import-section
        h1(data-i18n="import.title") MusicXML Reader
        p(data-i18n="import.subtitle") Open a MusicXML file to get started
        button#import-btn(data-i18n="import.openFile") Open a file
        input#file-input(type="file" multiple accept=importAccept)
        button#folder-btn(data-i18n="import.openFolder") Open a folder
        input#folder-input(type="file" webkitdirectory accept=importAccept)
        #install-section.hidden
          button#btn-install(data-i18n="import.install") Install Cantus
          p.install-subtitle(data-i18n="import.installSubtitle") Turn Cantus into a native app
    #overlay-loading
      .spinner
      p(data-i18n="loading") Loading…
    #overlay-error
      p#error-message(data-i18n="error.generic") Something went wrong.
    #settings-overlay.hidden
      #settings-header
        h2(data-i18n="settings.title") Settings
        button#settings-close(type="button" data-i18n-aria-label="settings.close" aria-label="Close settings") ✕
      section.settings-section(aria-labelledby="settings-display-title")
        h3#settings-display-title.settings-section-title(data-i18n="settings.sectionDisplay") Display
        .settings-group
          label.settings-label(for="zoom-range" data-i18n="settings.zoom") Zoom
          .settings-row.settings-slider-row
            input#zoom-range.settings-range(type="range" min="30" max="80" step="5" value="40" aria-label="Score zoom in percent" data-i18n-aria-label="settings.zoomAria")
            span#zoom-value.settings-value 40 %
        .settings-group
          span.settings-label(data-i18n="settings.layout") Layout
          .settings-row(role="group" aria-label="Layout" data-i18n-aria-label="settings.layout")
            button.layout-btn.active(type="button" data-layout="auto" data-i18n="layout.auto") Auto
            button.layout-btn(type="button" data-layout="horizontal" data-i18n="layout.horizontal") Horizontal
            button.layout-btn(type="button" data-layout="vertical" data-i18n="layout.vertical") Vertical
        .settings-group
          span.settings-label(data-i18n="settings.scroll") Scrolling
          .settings-row(role="group" aria-label="Scrolling" data-i18n-aria-label="settings.scroll")
            button.scroll-unit-btn.active(type="button" data-unit="page" data-i18n="scroll.page") Per page
            button.scroll-unit-btn(type="button" data-unit="system" data-i18n="scroll.system") Per system
          #overlap-row.settings-row
            label.settings-inline-label(for="overlap-select" data-i18n="settings.overlap") Overlap
            select#overlap-select.settings-select
              option(value="0") 0 %
              option(value="10") 10 %
              option(value="20") 20 %
              option(value="30") 30 %
              option(value="40") 40 %
              option(value="50") 50 %
        .settings-group
          span.settings-label(data-i18n="settings.theme") Theme
          .settings-row(role="group" aria-label="Theme" data-i18n-aria-label="settings.theme")
            button.theme-btn.active(type="button" data-theme="white" data-i18n="theme.white") White
            button.theme-btn(type="button" data-theme="sepia" data-i18n="theme.sepia") Sepia
            button.theme-btn(type="button" data-theme="dark" data-i18n="theme.dark") Dark
        .settings-group
          span.settings-label(data-i18n="settings.tapZone") Tap zone
          .settings-row(role="group" aria-label="Tap zone" data-i18n-aria-label="settings.tapZone")
            button.tap-btn(type="button" data-size="20" data-i18n="tap.small") Small
            button.tap-btn.active(type="button" data-size="30" data-i18n="tap.normal") Normal
            button.tap-btn(type="button" data-size="40" data-i18n="tap.large") Large
        .settings-group
          label.settings-label(for="transpose-visual" data-i18n="settings.transposeVisualSection") Score transposition
          .settings-row
            select#transpose-visual.transpose-select.settings-select(data-i18n-aria-label="settings.transposeVisualAria")
      section.settings-section(aria-labelledby="settings-playback-title")
        h3#settings-playback-title.settings-section-title(data-i18n="settings.sectionPlayback") Playback
        .settings-group
          label.settings-label(for="master-volume-range" data-i18n="settings.masterVolume") Master volume
          .settings-row.settings-slider-row
            input#master-volume-range.settings-range(type="range" min="0" max="100" step="5" value="80" aria-label="Master volume" data-i18n-aria-label="settings.masterVolume")
            span#master-volume-value.settings-value 80 %
        .settings-group
          label.settings-label(for="tempo-input" data-i18n="settings.tempo") Playback tempo
          .settings-row.settings-tempo
            input#tempo-input.settings-number(type="number" min="20" max="300" step="1" value="80" inputmode="numeric" aria-label="Playback tempo per minute" data-i18n-aria-label="settings.tempoAria")
            span#tempo-unit.tempo-unit(title="quarter note") ♩
            span.tempo-per-min /min
            button#tempo-reset.settings-btn.tempo-reset(type="button" title="Reset to the file tempo" data-i18n-title="settings.tempoResetTitle" data-i18n="settings.tempoReset" disabled) File tempo
          p#tempo-hint.settings-hint.settings-tempo-hint(data-i18n="tempo.pending") Determining the file tempo…
        .settings-group
          label.settings-label(for="transpose-audio" data-i18n="settings.transposeAudioSection") Sound transposition
          .settings-row
            select#transpose-audio.transpose-select.settings-select(data-i18n-aria-label="settings.transposeAudioAria")
        .settings-group
          .settings-row.settings-checks
            label.settings-check
              input#piano-only(type="checkbox")
              span(data-i18n="settings.pianoOnly") Piano only
            label.settings-check
              input#follow-playback(type="checkbox" checked)
              span(data-i18n="settings.followPlayback") Follow scrolling
            label.settings-check
              input#expand-repeats(type="checkbox" checked)
              span(data-i18n="settings.expandRepeats") Expand repeats
          p.settings-hint(data-i18n="settings.expandRepeatsHint") Unchecked: linear playback in written order (no repeats, D.C./D.S., coda or endings).
      section#parts-group.settings-section.hidden(aria-labelledby="settings-parts-title")
        h3#settings-parts-title.settings-section-title(data-i18n="settings.parts") Parts
        .settings-group
          #parts-list
          .settings-row.settings-parts-bulk
            label.bulk-field
              span.bulk-label(data-i18n="settings.partsSizes") Sizes to
              select#parts-sizes-reset.bulk-select.settings-select(data-i18n-aria-label="settings.partsSizesAria")
            label.bulk-field
              span.bulk-label(data-i18n="settings.partsVolumes") Volumes to
              select#parts-volumes-reset.bulk-select.settings-select(data-i18n-aria-label="settings.partsVolumesAria")
      section.settings-section(aria-labelledby="settings-application-title")
        h3#settings-application-title.settings-section-title(data-i18n="settings.sectionApplication") Application
        .settings-group
          label.settings-label(for="language-select" data-i18n="settings.language") Language
          .settings-row
            select#language-select.settings-select
        .settings-group
          span.settings-label(data-i18n="settings.storage") Storage
          .settings-row
            span#storage-info 0MB / 16MB
            button#btn-storage.settings-btn(type="button" data-i18n="settings.clearCache") Clear cache
        #settings-install-group.settings-group.hidden
          span.settings-label(data-i18n="settings.installation") Installation
          .settings-row
            button#settings-install-btn.settings-btn.settings-install(type="button" data-i18n="import.install") Install Cantus
          p.settings-hint.settings-install-hint(data-i18n="import.installSubtitle") Turn Cantus into a native app
        .settings-group.settings-about
          span.settings-label(data-i18n="settings.about") About
          .settings-row
            span(data-i18n="settings.version") Cantus v1.0 - MusicXML Reader
          .settings-row
            span#build-date
          .settings-row
            small(data-i18n="settings.license") Free software under the GNU GPL v3 or later, with no warranty.
          .settings-row
            small
              a(href="https://github.com/jperon/cantus" target="_blank" rel="noopener" data-i18n="settings.sourceCode") Source code
            small
              a(href="https://github.com/jperon/cantus/blob/master/THIRD-PARTY.md" target="_blank" rel="noopener" data-i18n="settings.thirdParty") Third-party components
          .settings-row
            small
              span(data-i18n="settings.soundfontCredit") TimGM6mb General MIDI soundfont, SpessaSynth synthesis —
              = ' '
              a(href="https://www.gnu.org/licenses/old-licenses/gpl-2.0.html" target="_blank" rel="noopener") GPL-2.0
              = ' · '
              a(href="https://www.apache.org/licenses/LICENSE-2.0" target="_blank" rel="noopener") Apache-2.0
    #library-overlay.hidden
      #library-header
        h2(data-i18n="library.title") Library
        button#library-close(data-i18n-aria-label="library.close" aria-label="Close library") ✕
      #library-list
      #library-actions
        button#library-import-btn(data-i18n="library.addFile") Add a file
        input#library-file-input(type="file" multiple accept=importAccept)
        button#library-folder-btn(data-i18n="library.addFolder") Add a folder
        input#library-folder-input(type="file" webkitdirectory accept=importAccept)
    #export-overlay.hidden
      #export-dialog(role="dialog" aria-modal="true" aria-labelledby="export-title")
        #export-header
          h2#export-title(data-i18n="export.title") Export the score
          button#export-close(type="button" aria-label="Close export" data-i18n-aria-label="export.close") ✕
        .settings-group
          label.settings-label(for="export-format" data-i18n="export.format") Format
          .settings-row
            select#export-format
        #export-actions
          button#export-cancel.settings-btn(type="button" data-i18n="export.cancel") Cancel
          button#export-confirm.settings-btn(type="button" data-i18n="export.confirm" disabled) Export
    #page-indicator
    #loading-indicator.hidden
      .spinner-small
    #command-bar.hidden
      #transport.transport-group.hidden(role="group" aria-label="Audio playback" data-i18n-aria-label="transport.group")
        button#transport-play.transport-btn(type="button" title="Play / pause (p)" data-i18n-title="transport.playPauseTitle" aria-label="Play" data-i18n-aria-label="transport.playAria") ▶
        input#transport-seek.transport-seek(type="range" min="0" max="1000" step="1" value="0" aria-label="Playback position" data-i18n-aria-label="transport.seekAria")
        span#transport-time 0:00 / 0:00
      #nav-buttons.nav-group
        button.nav-btn(type="button" data-action="prev-mov" title="Previous movement" data-i18n-title="nav.prevMovement" aria-label="Previous movement" data-i18n-aria-label="nav.prevMovement") ⏮
        button#page-number(type="button" title="Go to a page" data-i18n-title="nav.pageSelectorTitle" aria-label="Go to a page" data-i18n-aria-label="nav.pageSelectorTitle" aria-haspopup="dialog") 1/1
        button.nav-btn(type="button" data-action="next-mov" title="Next movement" data-i18n-title="nav.nextMovement" aria-label="Next movement" data-i18n-aria-label="nav.nextMovement") ⏭
      #command-actions.icons-group
        button#btn-library.hidden(type="button" title="Library" data-i18n-title="nav.library" aria-label="Library" data-i18n-aria-label="nav.library") ☰
        button#btn-menu.hidden(type="button" title="Menu" data-i18n-title="nav.menu" aria-label="Menu" data-i18n-aria-label="nav.menu" aria-haspopup="menu" aria-expanded="false") ⋯
    #command-menu.hidden(role="menu" aria-labelledby="btn-menu" aria-label="Score actions" data-i18n-aria-label="nav.menuLabel")
      button#menu-export(type="button" role="menuitem" data-i18n="nav.export") Export
      button#menu-settings(type="button" role="menuitem" data-i18n="nav.settings") Settings
    #page-jump.hidden(role="dialog" aria-modal="true" aria-labelledby="page-jump-title")
      h2#page-jump-title(data-i18n="nav.pageSelectorTitle") Go to a page
      .page-jump-row
        input#page-jump-input(type="number" min="1" step="1" inputmode="numeric" aria-label="Page number" data-i18n-aria-label="nav.pageInputAria")
        span#page-jump-total / 1
      input#page-jump-range(type="range" min="1" max="1" step="1" value="1" aria-label="Page" data-i18n-aria-label="nav.pageRangeAria")
      .page-jump-actions
        button#page-jump-cancel.settings-btn(type="button" data-i18n="nav.pageCancel") Cancel
        button#page-jump-confirm.settings-btn(type="button" data-i18n="nav.pageGo") Go
    script.
      window.__musicaBuildDate = "#{buildDate}"
      window.__musicaScoretkAvailable = #{scoretkAvailable ? 'true' : 'false'}
      window.__musicaSoundfontAvailable = #{soundfontsAvailable ? 'true' : 'false'}
    script !{workerSetup}
    script !{fflateSetup}
    script !{mxlJs}
    script !{storageJs}
    script !{svgCacheJs}
    script !{playbackCacheJs}
    script !{midiJs}
    script !{formatsJs}
    script !{timelineJs}
    script !{i18nJs}
    //- Bundle SpessaSynth (window.__musicaSpessa) : la banque et le processeur
    //- AudioWorklet de soundfonts/ sont chargés paresseusement au premier play().
    script !{spessaJs}
    script !{audioJs}
    script !{playbackJs}
    script !{appJs}
