doctype html
html(lang="fr")
  head
    meta(charset="utf-8")
    meta(name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no")
    meta(name="mobile-web-app-capable" content="yes")
    meta(name="apple-mobile-web-app-capable" content="yes")
    meta(name="apple-mobile-web-app-status-bar-style" content="default")
    meta(name="apple-mobile-web-app-title" content="Partitions")
    meta(name="theme-color" content="#ffffff")
    title Liseuse MusicXML
    style !{css}
  body
    #reader
      #score-container
        #page-prev.svg-slot
        #page-current.svg-slot
        #page-next.svg-slot
      #tap-left
      #tap-right
      #import-section
        h1 Liseuse MusicXML
        p Ouvrir un fichier MusicXML pour commencer
        button#import-btn Ouvrir un fichier
        input#file-input(type="file" multiple accept=msczAvailable ? ".xml,.musicxml,.mxl,.mscz,.mscx" : ".xml,.musicxml,.mxl")
        button#folder-btn Ouvrir un dossier
        input#folder-input(type="file" webkitdirectory accept=msczAvailable ? ".xml,.musicxml,.mxl,.mscz,.mscx" : ".xml,.musicxml,.mxl")
    button#btn-library.hidden ☰
    button#btn-settings.hidden ⚙
    #overlay-loading
      .spinner
      p Chargement…
    #overlay-error
      p#error-message Une erreur est survenue.
    #settings-overlay.hidden
      #settings-header
        h2 Réglages
        button#settings-close ✕
      .settings-group
        label.settings-label Zoom
        .settings-row
          span#zoom-value 40
          input#zoom-range(type="range" min="30" max="80" step="5" value="40")
      .settings-group
        label.settings-label(for="master-volume-range") Volume général
        .settings-row
          span#master-volume-value 80
          input#master-volume-range(type="range" min="0" max="100" step="5" value="80" aria-label="Volume général")
      #parts-group.settings-group.hidden
        label.settings-label Voix
        #parts-list
        .settings-row
          button#parts-sizes-reset.settings-btn(type="button" disabled) Tailles à 100 %
          button#parts-volumes-reset.settings-btn(type="button" disabled) Volumes à 100 %
      .settings-group
        label.settings-label Lecture
        .settings-row
          label.settings-check
            input#follow-playback(type="checkbox" checked)
            span Suivre le défilement
      .settings-group
        label.settings-label Thème
        .settings-row
          button.theme-btn.active(data-theme="white") Blanc
          button.theme-btn(data-theme="sepia") Sépia
          button.theme-btn(data-theme="dark") Sombre
      .settings-group
        label.settings-label Zone de tap
        .settings-row
          button.tap-btn(data-size="20") Petite
          button.tap-btn.active(data-size="30") Normale
          button.tap-btn(data-size="40") Grande
      .settings-group
        label.settings-label Défilement
        .settings-row
          button.scroll-unit-btn.active(data-unit="page") Par page
          button.scroll-unit-btn(data-unit="system") Par système
        .settings-row#overlap-row
          span Recouvrement
          select#overlap-select
            option(value="0") 0 %
            option(value="10") 10 %
            option(value="20") 20 %
            option(value="30") 30 %
            option(value="40") 40 %
            option(value="50") 50 %
      .settings-group
        label.settings-label À propos
        .settings-row
          span Cantus v1.0 - Liseuse MusicXML
        .settings-row
          span#build-date
        .settings-row
          small Logiciel libre sous licence GNU GPL v3 ou ultérieure, sans aucune garantie.
        .settings-row
          small
            a(href="https://github.com/jperon/cantus" target="_blank" rel="noopener") Code source
          small
            a(href="https://github.com/jperon/cantus/blob/master/THIRD-PARTY.md" target="_blank" rel="noopener") Composants tiers
    #library-overlay.hidden
      #library-header
        h2 Bibliothèque
        button#library-close ✕
      #library-list
      #library-actions
        button#library-import-btn Ajouter un fichier
        input#library-file-input(type="file" multiple accept=msczAvailable ? ".xml,.musicxml,.mxl,.mscz,.mscx" : ".xml,.musicxml,.mxl")
        button#library-folder-btn Ajouter un dossier
        input#library-folder-input(type="file" webkitdirectory accept=msczAvailable ? ".xml,.musicxml,.mxl,.mscz,.mscx" : ".xml,.musicxml,.mxl")
    #page-indicator
    #loading-indicator.hidden
      .spinner-small
    #transport.hidden(role="group" aria-label="Lecture audio")
      button#transport-play.transport-btn(type="button" title="Lecture / pause (p)" aria-label="Lecture") ▶
      button#transport-stop.transport-btn(type="button" title="Arrêt (s)" aria-label="Arrêt") ■
      input#transport-seek(type="range" min="0" max="1000" step="1" value="0" aria-label="Position de lecture")
      span#transport-time(title="Cliquer pour se déplacer dans la lecture") 0:00 / 0:00
    #nav-buttons
      button.nav-btn(data-action="start" title="Début") ⏮
      button.nav-btn(data-action="prev-mov" title="Mouvement précédent") ◀◀
      button.nav-btn(data-action="prev-5" title="5 pages avant") −5
      span#page-number
      button.nav-btn(data-action="next-5" title="5 pages après") +5
      button.nav-btn(data-action="next-mov" title="Mouvement suivant") ▶▶
      button.nav-btn(data-action="end" title="Fin") ⏭
    script.
      window.__musicaBuildDate = "#{buildDate}"
      window.__musicaMsczAvailable = #{msczAvailable ? 'true' : 'false'}
    if msczInline
      script#mscz2xml-wasm-src(type="text/plain") !{msczInline.wasmJs}
      script#mscz2xml-wasm-b64(type="text/plain") !{msczInline.wasm}
    script#worker-src(type="text/js-worker") !{workerSource}
    script !{workerSetup}
    script !{fflateSetup}
    script !{mxlJs}
    script !{storageJs}
    script !{svgCacheJs}
    script !{midiJs}
    script !{audioJs}
    script !{playbackJs}
    if soundfontSamples
      //- Asset inerte : le SPA en file:// ne peut pas fetch, et l'évaluer avant
      //- la lib soundfont-player n'aurait aucun intérêt.
      script#soundfont-src(type="text/plain") !{soundfontSamples}
    script !{soundfontPlayerJs}
    if soundfontSamples
      //- Exécute l'asset inerte : définit MIDI.Soundfont dans le contexte global
      script.
        (function() {
          var src = document.getElementById('soundfont-src');
          if (!src) return;
          var script = document.createElement('script');
          script.textContent = src.textContent;
          document.head.appendChild(script);
        })();
    script !{appJs}
